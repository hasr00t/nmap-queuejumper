local nmap = require "nmap"
local shortport = require "shortport"
local stdnse = require "stdnse"
local string = require "string"
local table = require "table"

description = [[
Checks Microsoft Message Queuing (MSMQ) on TCP/1801 for CVE-2023-21554,
"QueueJumper", a critical unauthenticated remote code execution vulnerability.

This script reproduces the two-stage differential check used by the Metasploit
module auxiliary/scanner/msmq/cve_2023_21554_queuejumper. The exact probe bytes
were generated from that module's packet construction and verified byte-for-byte
(the "LIOR" signature at offset 4, the packet_size field equal to the 2380-byte
length, and the SRMPEnvelopeHeader DataLength field at offset 232).

Stage 1 sends a well-formed MSMQ SRMP message. Any live MSMQ instance, patched
or not, replies with a packet containing the static 4-byte signature "LIOR"
(0x4C494F52). This only confirms that the service is MSMQ.

Stage 2 resends the message with the SRMPEnvelopeHeader DataLength field
increased by 0x80000000, which triggers an integer overflow in the size check.
  * Vulnerable (unpatched) hosts still reply; the response contains "LIOR".
  * Patched hosts detect the overflow, raise an exception, and send no response.

The check is crash-safe. It does not deliver an out-of-bounds write. It only
distinguishes patched from unpatched by whether a reply comes back.

Outcomes reported:
  VULNERABLE          MSMQ present and it replied to the stage-2 overflow probe.
  NOT VULNERABLE      MSMQ present but silent on stage 2 (consistent with patched).
  LIKELY (review)     MSMQ present but stage 2 gave an unexpected response.
  NOT MSMQ            Port answered but no "LIOR" signature was seen.
  INCONCLUSIVE        Could not complete the probe (connect/send/timeout issue).

Because it relies on an open, reachable TCP/1801, a host whose 1801 is filtered
or closed cannot be assessed remotely; corroborate those with a credentialed
patch check (missing April 2023 update / MSMQ binary version).
]]

---
-- @usage nmap -Pn -p1801 --script ms-msmq-queuejumper <target>
-- @usage nmap -Pn -p1801 --script ms-msmq-queuejumper --script-args queuejumper.timeout=8000 <target>
--
-- @args queuejumper.timeout  Milliseconds to wait for each response. Default 5000.
--
-- @output
-- PORT     STATE SERVICE
-- 1801/tcp open  msmq
-- | ms-msmq-queuejumper:
-- |   cve: CVE-2023-21554 (QueueJumper) MSMQ RCE
-- |   state: VULNERABLE
-- |   evidence: MSMQ replied to the malformed SRMP (DataLength overflow) probe; overflow was not rejected.
-- |   cvss: 9.8 CRITICAL CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:H/I:H/A:H
-- |_  note: Missing the April 2023 patch for CVE-2023-21554.

author = "Authorized pentest use. Packet layout ported from the Metasploit module by Bastian Kanbach (@__bka__); vulnerability discovery by Wayne Low and Haifei Li."
license = "Same as Nmap--See https://nmap.org/book/man-legal.html"
categories = {"vuln", "safe"}

-- Ground-truth probe bytes (hex). PKT2 is identical to PKT1 except for the 4
-- DataLength bytes at offset 232 (value += 0x80000000).
local PKT1_HEX = ""
local PKT2_HEX = ""

local function fromhex(s)
  return (s:gsub("%x%x", function(cc) return string.char(tonumber(cc, 16)) end))
end

portrule = shortport.port_or_service(1801, "msmq", "tcp")

-- Read a reply, tolerating small TCP fragmentation. Returns:
--   data (string), nil        on success (data may be "")
--   "",  err                  when the peer sent nothing (timeout/EOF) -> no response
local function read_reply(sock)
  local status, data = sock:receive()
  if not status then
    return "", data              -- data holds "TIMEOUT" / "EOF" / etc.
  end
  local buf = data
  if not buf:find("LIOR", 1, true) then
    for _ = 1, 2 do
      local s2, d2 = sock:receive()
      if not s2 then break end
      buf = buf .. d2
      if buf:find("LIOR", 1, true) then break end
    end
  end
  return buf, nil
end

-- One message over a fresh connection (the module uses connect/send/recv/close
-- per message). Returns:
--   response_string, nil       (response may be "" meaning no reply)
--   nil, err                   transport failure before a reply was possible
local function probe(host, port, payload, timeout)
  local sock = nmap.new_socket()
  sock:set_timeout(timeout)
  local ok, err = sock:connect(host, port)
  if not ok then
    sock:close()
    return nil, ("connect failed: %s"):format(tostring(err))
  end
  ok, err = sock:send(payload)
  if not ok then
    sock:close()
    return nil, ("send failed: %s"):format(tostring(err))
  end
  local resp, rerr = read_reply(sock)
  sock:close()
  return resp, nil, rerr
end

local function result(fields)
  local out = stdnse.output_table()
  for _, kv in ipairs(fields) do
    out[kv[1]] = kv[2]
  end
  return out
end

action = function(host, port)
  local timeout = tonumber(stdnse.get_script_args("queuejumper.timeout")) or 5000
  local pkt1 = fromhex(PKT1_HEX)
  local pkt2 = fromhex(PKT2_HEX)

  -- Stage 1: confirm MSMQ presence.
  local resp1, terr1, rerr1 = probe(host, port, pkt1, timeout)
  if resp1 == nil then
    return result({
      {"cve", "CVE-2023-21554 (QueueJumper)"},
      {"state", "INCONCLUSIVE"},
      {"evidence", "Stage 1 transport error: " .. tostring(terr1)},
      {"note", "Could not reach MSMQ to probe. Corroborate with a credentialed patch check."},
    })
  end
  if not resp1:find("LIOR", 1, true) then
    if resp1 == "" then
      return result({
        {"cve", "CVE-2023-21554 (QueueJumper)"},
        {"state", "INCONCLUSIVE"},
        {"evidence", "No response to a well-formed MSMQ probe (" .. tostring(rerr1) .. ")."},
        {"note", "Port is open but MSMQ did not answer: possibly filtered upstream, service stopped, or non-MSMQ. Cannot confirm remotely; use a credentialed patch check."},
      })
    end
    return result({
      {"cve", "CVE-2023-21554 (QueueJumper)"},
      {"state", "NOT MSMQ"},
      {"evidence", "Port answered but returned no 'LIOR' signature."},
      {"note", "Service on this port does not appear to be MSMQ."},
    })
  end

  -- MSMQ confirmed. Stage 2: malformed (integer-overflow) probe.
  local resp2, terr2, rerr2 = probe(host, port, pkt2, timeout)
  if resp2 == nil then
    return result({
      {"cve", "CVE-2023-21554 (QueueJumper)"},
      {"state", "INCONCLUSIVE"},
      {"evidence", "MSMQ confirmed in stage 1, but stage 2 hit a transport error: " .. tostring(terr2)},
      {"note", "Re-run; if it persists, corroborate with a credentialed patch check."},
    })
  end

  if resp2:find("LIOR", 1, true) then
    return result({
      {"cve", "CVE-2023-21554 (QueueJumper) MSMQ RCE"},
      {"state", "VULNERABLE"},
      {"evidence", "MSMQ replied to the malformed SRMP (DataLength overflow) probe; the overflow was not rejected."},
      {"cvss", "9.8 CRITICAL CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:H/I:H/A:H"},
      {"note", "Host is missing the April 2023 patch for CVE-2023-21554."},
      {"references", "https://msrc.microsoft.com/update-guide/vulnerability/CVE-2023-21554"},
    })
  elseif resp2 == "" then
    return result({
      {"cve", "CVE-2023-21554 (QueueJumper)"},
      {"state", "NOT VULNERABLE"},
      {"evidence", "MSMQ confirmed, but no response to the malformed probe (" .. tostring(rerr2) .. "); the overflow was rejected."},
      {"note", "Consistent with a patched host (April 2023 update applied)."},
    })
  else
    return result({
      {"cve", "CVE-2023-21554 (QueueJumper)"},
      {"state", "LIKELY VULNERABLE (manual review)"},
      {"evidence", "MSMQ confirmed; stage 2 returned an unexpected, non-LIOR response."},
      {"note", "Unusual behaviour. Verify manually before reporting a verdict."},
    })
  end
end
